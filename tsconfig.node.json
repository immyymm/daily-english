{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "api/**/*.ts",
    "src/config/release.ts",
    "src/schemas/**/*.ts",
    "src/types.ts",
    "content/release.json"
  ]
}
