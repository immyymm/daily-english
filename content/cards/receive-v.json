  "synonyms": [
    {
      "word": "get",
      "phonetic": "/ˈɡɛt/",
      "partOfSpeech": "v.",
      "chinese": "收到",
      "difference": "最常见口语表达，范围很广；receive 较正式，并突出成为传递动作的接收方。"
